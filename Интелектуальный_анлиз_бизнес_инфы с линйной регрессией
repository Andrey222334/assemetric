      "cell_type": "code",
      "source": [
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "from sklearn.linear_model import LinearRegression\n",
        "from sklearn.metrics import mean_squared_error, r2_score\n",
        "\n",
        "# Читаем данные из 08.csv\n",
        "X = []\n",
        "Y = []\n",
        "\n",
        "with open('08.csv', 'r') as data:\n",
        "    i = 0\n",
        "    for line in data:\n",
        "        Y.append([float(line.strip())])\n",
        "        X.append([i])\n",
        "        i += 1\n",
        "\n",
        "# Размер исходной выборки\n",
        "n = len(Y)\n",
        "\n",
        "# Добавляем 100 будущих точек\n",
        "for i in range(n, n + 100):\n",
        "    X.append([i])\n",
        "\n",
        "# Обучение линейной регрессии\n",
        "model = LinearRegression()\n",
        "model.fit(X[:n], Y)\n",
        "\n",
        "# Прогноз\n",
        "R = model.predict(X)\n",
        "\n",
        "# Параметры линии\n",
        "a = round(model.coef_[0][0], 3)\n",
        "b = round(model.intercept_[0], 3)\n",
        "\n",
        "# Метрики качества\n",
        "RMSE = round(mean_squared_error(Y, R[:n]) ** 0.5, 3)\n",
        "R2 = round(r2_score(Y, R[:n]), 3)\n",
        "\n",
        "# Заголовок\n",
        "title = (\n",
        "    f\"Линейный прогноз: y = {a}x + {b}\\n\"\n",
        "    f\"RMSE = {RMSE}, R² = {R2}\"\n",
        ")\n",
        "\n",
        "# Построение графика\n",
        "plt.figure(figsize=(8, 8))\n",
        "\n",
        "# Прогноз\n",
        "plt.plot(R, color='green', label='Прогноз')\n",
        "\n",
        "# Исходные значения\n",
        "plt.scatter(range(n), [y[0] for y in Y], color='blue', s=10, label='Исходные данные')\n",
        "\n",
        "plt.title(title)\n",
        "plt.xlabel(\"Номер наблюдения\")\n",
        "plt.ylabel(\"Значение\")\n",
        "plt.grid(True)\n",
        "plt.xlim(0 - int(n * 0.05), int((n + 100) * 1.05))\n",
        "plt.ylim(0 - int(max([y[0] for y in Y]) * 0.05), max([y[0] for y in Y]) * 1.05)\n",
        "plt.legend()\n",
        "\n",
        "plt.show()\n"
      ],
