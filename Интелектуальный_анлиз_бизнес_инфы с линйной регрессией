        "\n",
        "filename = \"готовый ссв.csv\"  # при необходимости поменяйте имя файла\n",
        "\n",
        "values = [v for v in values if 5 < v < 30]\n",
        "\n",
        "\n",
        "with open(filename, \"r\", encoding=\"utf-8-sig\") as f:\n",
        "    for line in f:\n",
        "        line = line.strip()\n",
        "        if not line:\n",
        "            continue\n",
        "\n",
        "        # убираем BOM\n",
        "        line = line.replace(\"\\ufeff\", \"\")\n",
        "\n",
        "        # если есть ; — берём только часть до него\n",
        "        if \";\" in line:\n",
        "            line = line.split(\";\")[0]\n",
        "\n",
        "        # заменяем запятую на точку\n",
        "        line = line.replace(\",\", \".\")\n",
        "\n",
        "        try:\n",
        "            v = float(line)\n",
        "        except ValueError:\n",
        "            # если строка всё равно не число — пропускаем\n",
        "            continue\n",
        "\n",
        "        values.append(v)\n",
        "\n",
        "if not values:\n",
        "    raise ValueError(\"Не удалось считать ни одного числа из файла. Проверьте имя файла и кодировку.\")\n",
        "\n",
        "# переводим в массивы для sklearn\n",
        "Y = np.array(values).reshape(-1, 1)\n",
        "n = len(Y)\n",
        "X = np.arange(n).reshape(-1, 1)\n",
        "\n",
        "# добавляем 100 будущих точек\n",
        "X_all = np.arange(n + 100).reshape(-1, 1)\n",
        "\n",
        "model = LinearRegression()\n",
        "model.fit(X, Y)\n",
        "\n",
        "R = model.predict(X_all)\n",
        "\n",
        "a = float(model.coef_[0][0])\n",
        "b = float(model.intercept_[0])\n",
        "\n",
        "RMSE = mean_squared_error(Y, R[:n]) ** 0.5\n",
        "R2 = r2_score(Y, R[:n])\n",
        "\n",
        "title = (\n",
        "    f\"Линейный прогноз: y = {a:.3f}x + {b:.3f}\\n\"\n",
        "    f\"RMSE = {RMSE:.3f}, R² = {R2:.3f}\"\n",
        ")\n",
        "\n",
        "plt.figure(figsize=(8, 8))\n",
        "plt.plot(X_all, R, label=\"Прогноз\", linewidth=2)\n",
        "plt.scatter(X, Y, s=10, label=\"Исходные данные\")\n",
        "\n",
        "plt.title(title)\n",
        "plt.xlabel(\"Номер наблюдения (день)\")\n",
        "plt.ylabel(\"Курс CNY/RUB\")\n",
        "plt.grid(True)\n",
        "plt.legend()\n",
        "plt.show()\n"
